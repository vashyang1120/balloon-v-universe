  "    var dispImg = document.getElementById(\"av-preview-img\");",
  "    var gAv = document.getElementById(\"g-avatar\");",
  "    if(baseImg) baseImg.src = getAvatarUrl(PLAYER.baseAvatarKey);",
  "    if(dispImg) dispImg.src = getAvatarUrl(PLAYER.displayAvatarKey);",
  "    if(gAv) gAv.src = PLAYER.avatarSrc || getAvatarUrl(PLAYER.displayAvatarKey);",
  "    var gname = document.getElementById(\"g-name\");",
  "    if(gname) gname.textContent = PLAYER.id;",
  "    hideAvGrid();",
  "    refreshPlayerMetaUI();",
  "    showDiffSelect(\"profile\");",
  "  });",
  "});",
