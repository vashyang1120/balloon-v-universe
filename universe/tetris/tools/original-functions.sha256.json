  "$(\"btn-res-lb\").addEventListener(\"click\",()=>{showScreen(\"s-lb\");loadLB();});",
  "$(\"btn-res-home\").addEventListener(\"click\",()=>{ refreshPlayerMetaUI(); showScreen(\"s-title\"); });",
