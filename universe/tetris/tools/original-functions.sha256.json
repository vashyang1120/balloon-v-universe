  "  if(isChangingIdentity){",
  "    if(!confirm(\"⚠️ 更改玩家 ID 或身份頭像會切換玩家身份\\n\\n你的排行榜身份與解鎖頭像會依新身份重新讀取。\\n新身份可能還沒有原本解鎖的頭像。\\n\\n是否繼續？\")){",
