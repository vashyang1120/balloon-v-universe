  "// ── V幣 Foundation：品牌宇宙每日完成獎勵 ──",
  "// pause",
  "document.getElementById(\"pause-btn\").addEventListener(\"click\",togglePause);",
  "document.getElementById(\"btn-quit\").addEventListener(\"click\",()=>{",
  "  if(!running||confirm(\"確定要離開嗎？\")){running=false;if(raf)cancelAnimationFrame(raf);showScreen(\"s-title\");}",
  "});",
  "// keyboard",
  "document.addEventListener(\"keydown\",e=>{",
  "  if(e.key===\"Escape\"){togglePause();return;}",
  "  if(!running||paused) return;",
  "  if(e.key===\"ArrowLeft\"){e.preventDefault();mLeft();}",
  "  else if(e.key===\"ArrowRight\"){e.preventDefault();mRight();}",
  "  else if(e.key===\"ArrowDown\"){e.preventDefault();if(!mDown())lock();}",
  "  else if(e.key===\"ArrowUp\"){e.preventDefault();tryRotate();}",
  "  else if(e.key===\" \"){e.preventDefault();hardDrop();}",
  "  else if(e.key===\"z\"||e.key===\"Z\") tryRotate();",
  "});",
  "// mobile",
  "document.getElementById(\"mob-left\").addEventListener(\"click\",mLeft);",
  "document.getElementById(\"mob-right\").addEventListener(\"click\",mRight);",
  "document.getElementById(\"mob-down\").addEventListener(\"click\",()=>{if(running&&!paused){if(!mDown())lock();}});",
  "document.getElementById(\"mob-rotl\").addEventListener(\"click\",()=>{if(running&&!paused)tryRotate();});",
  "document.getElementById(\"mob-drop\").addEventListener(\"click\",hardDrop);",
  "// touch swipe on board",
  "let tx0=0,ty0=0,tyL=0;",
  "document.getElementById(\"board-canvas\").addEventListener(\"touchstart\",e=>{tx0=e.touches[0].clientX;ty0=tyL=e.touches[0].clientY;},{passive:true});",
  "document.getElementById(\"board-canvas\").addEventListener(\"touchmove\",e=>{",
  "  if(!running||paused) return;",
  "  const dy=e.touches[0].clientY-tyL; tyL=e.touches[0].clientY;",
  "  if(dy>8){if(!mDown())lock();}",
  "},{passive:true});",
  "document.getElementById(\"board-canvas\").addEventListener(\"touchend\",e=>{",
  "  const dx=e.changedTouches[0].clientX-tx0,dy=e.changedTouches[0].clientY-ty0;",
  "  if(Math.abs(dx)>40&&Math.abs(dx)>Math.abs(dy)){dx>0?mRight():mLeft();}",
  "  else if(dy<-40) tryRotate();",
  "  else if(dy>60) hardDrop();",
  "},{passive:true});",
  "// ── SOUND EFFECTS ──",
  "let audioCtx=null;",
  "const sfx={",
  "  move(){ tone(220,\"sine\",.06,.08); },",
  "  rotate(){ tone(330,\"sine\",.08,.1); tone(440,\"sine\",.06,.08,.04); },",
  "  drop(){ tone(180,\"sine\",.1,.15); tone(120,\"sine\",.08,.1,.05); },",
  "  lock(){ tone(200,\"triangle\",.06,.12); tone(160,\"triangle\",.08,.1,.03); },",
  "  clear1(){ tone(523,\"sine\",.1,.25); tone(659,\"sine\",.1,.2,.08); tone(784,\"sine\",.15,.18,.16); },",
  "  clear2(){ [523,659,784,1047].forEach((f,i)=>tone(f,\"sine\",.1,.22,i*.06)); },",
  "  clear3(){ [523,659,784,1047,1319].forEach((f,i)=>tone(f,\"sine\",.12,.25,i*.055)); },",
  "  clear4(){ [659,784,880,1047,880,784,659].forEach((f,i)=>tone(f,\"square\",.1,.3,i*.07)); setTimeout(()=>noise(.3,.08),200); },",
  "  clear5(){ [440,554,659,880,1109].forEach((f,i)=>tone(f,\"sawtooth\",.1,.2,i*.05)); noise(.2,.06); },",
  "  clear10(){ [523,659,784,1047,1319,1047,784,1319].forEach((f,i)=>tone(f,\"square\",.12,.35,i*.06)); setTimeout(()=>noise(.5,.12),100); },",
  "  levelUp(){ [523,659,784,1047,1319].forEach((f,i)=>tone(f,\"sine\",.15,.3,i*.08)); },",
  "  allClear(){ [523,659,784,1047,1319,1568,2093].forEach((f,i)=>tone(f,\"sine\",.18,.35,i*.07)); setTimeout(()=>noise(.6,.15),300); },",
  "  gameOver(){ [440,392,349,330,294,262].forEach((f,i)=>tone(f,\"sawtooth\",.2,.25,i*.12)); noise(.4,.1); },",
  "  danger(){ tone(220,\"sawtooth\",.15,.2); tone(110,\"sawtooth\",.15,.15,.1); },",
  "};",
  "// ── MUSIC PLAYER ──",
  "const SONG_BASE=\"https://vashyang1120.github.io/vparty-rhythm-game/\";",
  "const EMOJIS=[\"🎈\",\"🎤\",\"✨\",\"💫\",\"🌟\",\"🎵\",\"🎶\",\"🎀\",\"🎪\",\"⭐\"];",
  "let SONGS=[];",
  "let mAudio=new Audio(), mIdx=0, mPlaying=false, musicWasPlayingBeforePause=false, mLoop=\"all\", mShuf=false, mProgTmr=null;",
  "mAudio.volume=.1;",
  "mAudio.addEventListener(\"ended\",()=>{",
  "  if(mLoop===\"one\"){mAudio.currentTime=0;playSong();}",
  "  else if(mLoop===\"all\"){loadSong(mIdx+1,true);}",
  "  else{mPlaying=false;updPlayBtns();$(\"mp-disc\").classList.remove(\"playing\");stopProg();}",
  "});",
  "$(\"mc-prev\").addEventListener(\"click\",()=>{if(SONGS.length)loadSong(mIdx-1,mPlaying);});",
  "$(\"mc-next\").addEventListener(\"click\",()=>{if(SONGS.length)loadSong(mIdx+1,mPlaying);});",
  "$(\"mc-play\").addEventListener(\"click\",togglePlay);",
  "$(\"mc-list\").addEventListener(\"click\",openMusic);",
  "$(\"mp-prev2\").addEventListener(\"click\",()=>{if(SONGS.length)loadSong(mIdx-1,mPlaying);});",
  "$(\"mp-next2\").addEventListener(\"click\",()=>{if(SONGS.length)loadSong(mIdx+1,mPlaying);});",
  "$(\"mp-play2\").addEventListener(\"click\",togglePlay);",
  "$(\"mp-close\").addEventListener(\"click\",closeMusic);",
  "$(\"music-modal\").addEventListener(\"click\",e=>{if(e.target===$(\"music-modal\"))closeMusic();});",
  "$(\"mp-prog\").addEventListener(\"click\",e=>{",
  "  const r=$(\"mp-prog\").getBoundingClientRect();",
  "  const pct=(e.clientX-r.left)/r.width;",
  "  const dur=mAudio.duration||SONGS[mIdx]?.duration||120;",
  "  mAudio.currentTime=pct*dur;",
  "});",
  "$(\"mp-vol\").addEventListener(\"input\",e=>{mAudio.volume=e.target.value/100;});",
  "$(\"mp-shuf\").addEventListener(\"click\",()=>{",
  "  mShuf=!mShuf; $(\"mp-shuf\").classList.toggle(\"act\",mShuf);",
  "  toast(mShuf?\"🔀 隨機開啟\":\"🔀 隨機關閉\");",
  "});",
  "$(\"mp-loop\").addEventListener(\"click\",()=>{",
  "  const modes=[\"all\",\"one\",\"none\"],labels=[\"全部循環\",\"單曲循環\",\"不循環\"],icons=[\"🔁\",\"🔂\",\"➡\"];",
  "  mLoop=modes[(modes.indexOf(mLoop)+1)%3];",
  "  const i=modes.indexOf(mLoop);",
  "  $(\"mp-loop\").textContent=icons[i]; $(\"mp-badge\").textContent=labels[i];",
  "  $(\"mp-loop\").classList.toggle(\"act\",mLoop!==\"none\");",
  "  toast(\"循環模式：\"+labels[i]);",
  "});",
  "$(\"btn-music-title\").addEventListener(\"click\",openMusic);",
  "// ── LEADERBOARD ──",
