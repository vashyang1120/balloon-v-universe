  "      PLAYER.playerKey = makePlayerKey(profileOriginalId, profileOriginalBaseAvatarKey);",
  "      document.getElementById(\"player-id-input\").value = profileOriginalId;",
  "      var bImg = document.getElementById(\"base-avatar-preview\");",
  "      if(bImg) bImg.src = getAvatarUrl(profileOriginalBaseAvatarKey);",
  "      var hint = document.getElementById(\"profile-id-dirty-hint\");",
  "      if(hint) hint.style.display = \"none\";",
  "      hideAvGrid();",
  "      return;",
  "    }",
  "  }",
