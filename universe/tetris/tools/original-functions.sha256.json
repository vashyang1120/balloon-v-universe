  "  PLAYER.id = newId; PLAYER.name = newId;",
  "  PLAYER.baseAvatarKey = newBase;",
  "  PLAYER.playerKey = newPlayerKey;",
  "  // 保守重設 displayAvatarKey 為 baseAvatarKey，等 loadUnlockedAvatars 後再驗證",
  "  PLAYER.displayAvatarKey = newBase;",
  "  PLAYER.avatarKey = newBase;",
  "  PLAYER.avKey = newBase;",
  "  PLAYER.avatarSrc = getAvatarUrl(newBase);",
  "  PLAYER.avUrl = PLAYER.avatarSrc;",
  "  document.getElementById(\"profile-id-dirty-hint\").style.display = \"none\";",
  "  savePlayerLocal(); // 只存 localStorage，不提前觸發 ensurePlayerProfile",
  "  // 身份切換順序：loadAvatarCatalog → loadUnlockedAvatars → ensurePlayerProfile → validate",
  "  loadAvatarCatalog().then(function(){",
  "    return loadUnlockedAvatars();",
  "  }).then(function(res){",
  "    unlockedAvatars = res || {};",
  "    return ensurePlayerProfile();",
  "  }).then(function(){",
  "    validateDisplayAvatarForCurrentIdentity();",
