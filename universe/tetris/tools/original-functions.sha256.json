  "  }catch(e){ toast(\"刪除失敗\"); }",
  "};",
  "document.getElementById(\"btn-adm-clear\").addEventListener(\"click\",async()=>{",
  "  if(!confirm(\"這會清空排行榜資料（tetris-balloon/leaderboard 與 leaderboards/tetris），但會保留遊玩紀錄 gameLogs/tetris。確定繼續？\")) return;",
  "  const ok = await ensureFirebaseReady();",
  "  if(!ok){ toast(\"Firebase 尚未就緒\"); return; }",
