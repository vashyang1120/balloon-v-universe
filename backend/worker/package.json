{
  "name": "balloon-v-universe-api",
  "version": "0.1.0",
  "private": true,
  "description": "氣球小V遊戲宇宙 後端 API（Cloudflare Worker）",
  "type": "module",
  "main": "src/index.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test \"tests/*.test.js\"",
    "check": "node scripts/check-syntax.mjs && node scripts/scan-secrets.mjs",
    "verify": "npm run check && npm test",
    "dev": "wrangler dev",
    "deploy:dry": "wrangler deploy --dry-run --outdir .wrangler/dry-run",
    "deploy": "wrangler deploy"
  },
  "devDependencies": {
    "wrangler": "4.152.0"
  }
}
