// 氣球小V遊戲宇宙 後端 API — Cloudflare Worker 設定
// 專案根目錄：backend/worker/（所有 wrangler 指令都在這個資料夾執行）
//
// ⚠ 這個檔案會提交到 GitHub，所以「只能放公開設定」。
//   私密資料（Firebase 服務帳戶 JSON、管理員 UID 名單）一律放 Cloudflare Secrets，
//   見 README.md「Secrets」一節。不要把任何私密值寫進這裡。
{
  "$schema": "./node_modules/wrangler/config-schema.json",

  // Worker 名稱固定，必須和 Cloudflare 上已建立的 Worker 一致
  "name": "balloon-v-universe-api",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",

  // 使用 *.workers.dev 公開網址；不開預覽網址，避免多出未受控的公開入口
  "workers_dev": true,
  "preview_urls": false,

  // Workers Logs（免費方案可用，有每日上限）。程式只輸出已遮罩的結構化記錄
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },

  // 限流（Cloudflare Rate Limiting binding，v0.3.0-test-2 加入）
  // 數字需與 src/middleware/rate-limit.js 的 RULES 一致；period 只能是 10 或 60（秒）。
  // ⚠ Cloudflare 文件沒有說明 Workers Free 是否包含此功能，需在正式部署時確認：
  //   若部署失敗並提到 ratelimits，刪除這個區塊即可，程式會自動退回記憶體計數。
  "ratelimits": [
    { "name": "RL_CREATE_IP",     "namespace_id": "1001", "simple": { "limit": 60,  "period": 60 } },
    { "name": "RL_CREATE_GLOBAL", "namespace_id": "1002", "simple": { "limit": 300, "period": 60 } },
    { "name": "RL_LOOKUP_IP",     "namespace_id": "1003", "simple": { "limit": 300, "period": 60 } },
    { "name": "RL_SCORE_IP",      "namespace_id": "1004", "simple": { "limit": 120, "period": 60 } },
    { "name": "RL_READ_IP",       "namespace_id": "1005", "simple": { "limit": 600, "period": 60 } }
  ],

  // 公開設定（非私密）
  "vars": {
    "SERVICE_ENV": "production",

    // 允許呼叫 API 的網站來源（只比對「來源」，不含路徑；多個用逗號分隔）。
    // 四款遊戲與大廳都在 vashyang1120.github.io，所以一個來源就涵蓋全部。
    "ALLOWED_ORIGINS": "https://vashyang1120.github.io",

    // Firebase 專案 ID：由資料庫網址 balloon-v-universe-default-rtdb 推得，
    // 部署前請到 Firebase 主控台「專案設定 → 一般 → 專案 ID」確認完全相同。
    // 填錯不會開放權限，只會讓所有管理員 Token 驗證失敗（fail closed）。
    "FIREBASE_PROJECT_ID": "balloon-v-universe",
    "FIREBASE_DATABASE_URL": "https://balloon-v-universe-default-rtdb.asia-southeast1.firebasedatabase.app",

    // 呼叫 Firebase 的超時（毫秒）
    "FIREBASE_TIMEOUT_MS": "8000",

    // v0.3.0 正式成績／排行榜／V幣：預設關閉。驗收通過後由使用者把 "off" 改成 "on" 再部署才會開始寫入。
    //   SCORES_ENABLED  ：開始場次、提交成績、正式排行榜寫入
    //   REWARDS_ENABLED ：每日 +30／今日挑戰 +10 入帳（需要 SCORES_ENABLED 同時為 on）
    // v0.3.1：也可以設成 "trial"（受控試營運）：只有 TRIAL_PLAYER_IDS 名單內的玩家可以寫入，
    //   資料全部寫在 trial/ 底下（不碰正式排行榜與錢包），驗收後在管理後台清除再改成 "on"。
    // v0.3.1-trial-setup：受控試營運（使用者確認合併後由 Cloudflare 自動部署生效）
    //   只有下方測試玩家可以寫入；資料全部在 trial/；其他玩家照常遊玩但不寫入任何正式資料
    //   回復：三個值改回 "off"／"off"／""；試營運資料在管理後台「清除試營運資料」
    "SCORES_ENABLED": "trial",
    "REWARDS_ENABLED": "trial",
    "TRIAL_PLAYER_IDS": "p_qfvmhs7ewmcn6ez6bdub"
  }
}
